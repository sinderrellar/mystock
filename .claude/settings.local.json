      "Bash(git push --delete *)",
      "Bash(mongosh * drop *)",
      "Bash(mongosh * delete *)",
      "Bash(mongosh * remove *)",
      "Bash(mongo * drop *)",
      "Bash(mongo * delete *)",
      "Bash(mongo * remove *)"
